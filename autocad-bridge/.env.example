# AutoCAD Bridge Service — copy to .env and adjust (Windows host)
AUTOCAD_BRIDGE_PORT=8765
CORS_ALLOW_ORIGINS=http://localhost:3000

# COM retry (same semantics as markup_v4.0.py)
AUTOCAD_COM_RETRY_COUNT=12
AUTOCAD_COM_RETRY_DELAY=0.15
AUTOCAD_IMPORT_OBJECT_DELAY=0.05

# DWG layers
DEFAULT_IMPORT_LAYER=PDF_TAG_IMPORT
DEFAULT_IMPORT_LAYER_COLOR=5
DEFAULT_REV_CLOUD_LAYER=PDF_REV_CLOUD
DEFAULT_REV_CLOUD_COLOR=1
CREATE_REV_CLOUD=true
REV_CLOUD_MARGIN_FACTOR=0.80
REV_CLOUD_ARC_FACTOR=1.00
REV_CLOUD_BULGE=0.41421356237

# Text handling (same as markup_v4.0.py)
IGNORE_TEXT_CONTAINS=tidak ada di lapangan
TAG_NUDGE_X=0.0
TAG_NUDGE_Y=0.0
TEXT_HEIGHT_FACTOR=1.0
FORCE_ENDPOINT_OSNAP=true
